{
  "name": "infagent",
  "version": "0.1.0",
  "description": "InfAgent — TypeScript agent infrastructure toolkit (library + CLI).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "infagent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "serve": "node dist/server/main.js",
    "serve:dev": "tsx watch src/server/main.ts",
    "ui:install": "npm --prefix ui install",
    "ui:dev": "npm --prefix ui run dev",
    "dev:web": "tsx src/server/main.ts",
    "ui:build": "npm --prefix ui run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:from-txt": "node tools/env-from-txt.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "chat:ask": "node dist/cli.js chat ask",
    "chat:model": "node dist/cli.js chat download"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "node-llama-cpp": "^3.22.1"
  },
  "keywords": [
    "agent",
    "infra",
    "typescript",
    "cli"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
