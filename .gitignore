# ---------------------------------------------------------------------------
# Everything in this repository is committed, with three deliberate exceptions:
#
#   1. node_modules/    — hundreds of MB and 20k+ files; `npm install` restores it
#   2. *.gguf           — 380 MB model weights; fetched once by `npm run chat:model`
#   3. .env / env.txt   — real credentials; they must never enter git history
#
# Build output (dist/, ui/dist/), logs, coverage and the model settings files are
# all tracked on purpose: the repository is meant to be complete without them.
# ---------------------------------------------------------------------------

# 1. dependencies
node_modules/
.pnp/
.pnp.js

# 2. model weights (the settings files next to them ARE committed)
/models/*.gguf
/models/*.gguf.part
*.gguf

# 3. secrets — never committed
.env
.env.*
!.env.example
env.txt
*.env.bak
.netrc
.git-credentials

# Windows editors
Thumbs.db
Desktop.ini

# The toolbox writes what it loaded here; it is a cache, not source.
mcp/tools/.cache.json
