{
  "name": "infagent-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InfAgent interface \u2014 Vue 3 + Tailwind + daisyUI console for the agent script toolbox.",
  "scripts": {
    "dev": "vite",
